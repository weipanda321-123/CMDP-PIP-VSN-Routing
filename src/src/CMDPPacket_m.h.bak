        case 2: return long2string(pp->getCurrentHop());
        case 3: return long2string(pp->getTotalHops());
        case 4: return long2string(pp->getRoutePath(i));
        case 5: return double2string(pp->getCreationTime());
        case 6: return double2string(pp->getTotalDelay());
        case 7: return double2string(pp->getTotalTrustCost());
        case 8: return double2string(pp->getTrustBudget());
