    if (this==&other) return *this;
    ::omnetpp::cPacket::operator=(other);
    copy(other);
    return *this;
}

void CMDPRouteRequest::copy(const CMDPRouteRequest& other)
{
    this->srcVehicleId = other.srcVehicleId;
    this->dstVehicleId = other.dstVehicleId;
    this->trustBudget = other.trustBudget;
    this->requestTime = other.requestTime;
    this->seqNum = other.seqNum;
}

void CMDPRouteRequest::parsimPack(omnetpp::cCommBuffer *b) const
{
    ::omnetpp::cPacket::parsimPack(b);
    doParsimPacking(b,this->srcVehicleId);
    doParsimPacking(b,this->dstVehicleId);
    doParsimPacking(b,this->trustBudget);
    doParsimPacking(b,this->requestTime);
    doParsimPacking(b,this->seqNum);
}

