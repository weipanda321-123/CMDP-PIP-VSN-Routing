int CMDPDataPacketDescriptor::findField(const char *fieldName) const
{
    omnetpp::cClassDescriptor *basedesc = getBaseClassDescriptor();
    int base = basedesc ? basedesc->getFieldCount() : 0;
    if (fieldName[0]=='s' && strcmp(fieldName, "srcVehicleId")==0) return base+0;
    if (fieldName[0]=='d' && strcmp(fieldName, "dstVehicleId")==0) return base+1;
    if (fieldName[0]=='c' && strcmp(fieldName, "currentHop")==0) return base+2;
    if (fieldName[0]=='t' && strcmp(fieldName, "totalHops")==0) return base+3;
    if (fieldName[0]=='r' && strcmp(fieldName, "routePath")==0) return base+4;
    if (fieldName[0]=='c' && strcmp(fieldName, "creationTime")==0) return base+5;
    if (fieldName[0]=='t' && strcmp(fieldName, "totalDelay")==0) return base+6;
    if (fieldName[0]=='t' && strcmp(fieldName, "totalTrustCost")==0) return base+7;
    if (fieldName[0]=='t' && strcmp(fieldName, "trustBudget")==0) return base+8;
    if (fieldName[0]=='r' && strcmp(fieldName, "routingComplete")==0) return base+9;
    if (fieldName[0]=='s' && strcmp(fieldName, "seqNum")==0) return base+10;
    return basedesc ? basedesc->findField(fieldName) : -1;
}

