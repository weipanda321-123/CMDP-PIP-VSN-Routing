{
    ::omnetpp::cPacket::parsimUnpack(b);
    doParsimUnpacking(b,this->srcVehicleId);
    doParsimUnpacking(b,this->dstVehicleId);
    doParsimUnpacking(b,this->trustBudget);
    doParsimUnpacking(b,this->requestTime);
    doParsimUnpacking(b,this->seqNum);
}

