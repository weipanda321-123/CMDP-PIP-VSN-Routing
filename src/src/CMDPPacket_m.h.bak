        field -= basedesc->getFieldCount();
    }
    CMDPRelayAck *pp = (CMDPRelayAck *)object; (void)pp;
    switch (field) {
        case 0: pp->setRelayVehicleId(string2long(value)); return true;
        case 1: pp->setForVehicleId(string2long(value)); return true;
        case 2: pp->setAccepted(string2bool(value)); return true;
        case 3: pp->setMeasuredDelay(string2double(value)); return true;
        case 4: pp->setMeasuredSnir(string2double(value)); return true;
        case 5: pp->setSeqNum(string2long(value)); return true;
        default: return false;
    }
}

