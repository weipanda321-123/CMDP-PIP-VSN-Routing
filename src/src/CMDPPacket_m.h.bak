void CMDPRelayAck::parsimPack(omnetpp::cCommBuffer *b) const
{
    ::omnetpp::cPacket::parsimPack(b);
    doParsimPacking(b,this->relayVehicleId);
    doParsimPacking(b,this->forVehicleId);
    doParsimPacking(b,this->accepted);
    doParsimPacking(b,this->measuredDelay);
    doParsimPacking(b,this->measuredSnir);
    doParsimPacking(b,this->seqNum);
}

void CMDPRelayAck::parsimUnpack(omnetpp::cCommBuffer *b)
{
    ::omnetpp::cPacket::parsimUnpack(b);
    doParsimUnpacking(b,this->relayVehicleId);
    doParsimUnpacking(b,this->forVehicleId);
    doParsimUnpacking(b,this->accepted);
    doParsimUnpacking(b,this->measuredDelay);
    doParsimUnpacking(b,this->measuredSnir);
    doParsimUnpacking(b,this->seqNum);
}

