int CMDPRelayAckDescriptor::findField(const char *fieldName) const
{
    omnetpp::cClassDescriptor *basedesc = getBaseClassDescriptor();
    int base = basedesc ? basedesc->getFieldCount() : 0;
    if (fieldName[0]=='r' && strcmp(fieldName, "relayVehicleId")==0) return base+0;
    if (fieldName[0]=='f' && strcmp(fieldName, "forVehicleId")==0) return base+1;
    if (fieldName[0]=='a' && strcmp(fieldName, "accepted")==0) return base+2;
    if (fieldName[0]=='m' && strcmp(fieldName, "measuredDelay")==0) return base+3;
    if (fieldName[0]=='m' && strcmp(fieldName, "measuredSnir")==0) return base+4;
    if (fieldName[0]=='s' && strcmp(fieldName, "seqNum")==0) return base+5;
    return basedesc ? basedesc->findField(fieldName) : -1;
}

