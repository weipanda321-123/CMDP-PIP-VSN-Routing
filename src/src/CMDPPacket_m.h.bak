    routePath_arraysize = other.routePath_arraysize;
    for (unsigned int i=0; i<routePath_arraysize; i++)
        this->routePath[i] = other.routePath[i];
    this->creationTime = other.creationTime;
    this->totalDelay = other.totalDelay;
    this->totalTrustCost = other.totalTrustCost;
    this->trustBudget = other.trustBudget;
    this->routingComplete = other.routingComplete;
