        case 2: pp->setCurrentHop(string2long(value)); return true;
        case 3: pp->setTotalHops(string2long(value)); return true;
        case 4: pp->setRoutePath(i,string2long(value)); return true;
        case 5: pp->setCreationTime(string2double(value)); return true;
        case 6: pp->setTotalDelay(string2double(value)); return true;
        case 7: pp->setTotalTrustCost(string2double(value)); return true;
        case 8: pp->setTrustBudget(string2double(value)); return true;
        case 9: pp->setRoutingComplete(string2bool(value)); return true;
        case 10: pp->setSeqNum(string2long(value)); return true;
        default: return false;
    }
}

